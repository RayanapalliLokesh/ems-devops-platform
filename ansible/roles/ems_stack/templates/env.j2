# managed by Ansible (role ems_stack) - read by docker compose in {{ ems_root }}
COMPOSE_PROJECT_NAME=ems
EMS_IMAGE={{ ems_image }}
EMS_IMAGE_TAG={{ ems_deploy_tag }}
EMS_HTTP_PORT={{ ems_http_port }}
TRUSTED_PROXIES={{ ems_trusted_proxies }}
GUNICORN_WORKERS={{ ems_gunicorn_workers }}
SEED_DEMO_DATA={{ ems_seed_demo_data | lower }}
LOG_LEVEL=INFO
POSTGRES_DB=ems
POSTGRES_USER=ems
POSTGRES_PASSWORD={{ ems_secrets.POSTGRES_PASSWORD }}
SECRET_KEY={{ ems_secrets.SECRET_KEY }}
GRAFANA_ADMIN_PASSWORD={{ ems_secrets.GRAFANA_ADMIN_PASSWORD }}
