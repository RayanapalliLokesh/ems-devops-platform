# Copy to secret.env (gitignored) and replace both values, or run scripts/k8s/k8s-up.sh which generates them.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Use hex only for POSTGRES_PASSWORD: it is embedded in DATABASE_URL without URL-encoding.
SECRET_KEY=change-me-to-64-hex-characters
POSTGRES_PASSWORD=change-me-to-32-hex-characters
