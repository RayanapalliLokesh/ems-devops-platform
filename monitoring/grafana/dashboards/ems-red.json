{
  "uid": "ems-red",
  "title": "EMS - RED (rate, errors, duration)",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "ems"
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Availability SLI (5m)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - ems:slo_errors:ratio_rate5m",
          "legendFormat": "available"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Requests faster than 500 ms (5m)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - ems:slo_latency:ratio_rate5m",
          "legendFormat": "fast"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Database up",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ems_db_up",
          "legendFormat": "db"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Employees",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ems_employees_total",
          "legendFormat": "employees"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Rate: requests per second by endpoint",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (endpoint) (rate(ems_http_requests_total{job=\"ems-app\",endpoint!=\"/metrics\"}[5m]))",
          "legendFormat": "{{endpoint}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Errors: 5xx ratio",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ems:slo_errors:ratio_rate5m",
          "legendFormat": "5m"
        },
        {
          "refId": "B",
          "expr": "ems:slo_errors:ratio_rate1h",
          "legendFormat": "1h"
        },
        {
          "refId": "C",
          "expr": "vector(0.005)",
          "legendFormat": "SLO budget 0.5%"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Duration: p50 / p95 / p99",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(ems_http_request_duration_seconds_bucket{job=\"ems-app\",endpoint!=\"/metrics\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(ems_http_request_duration_seconds_bucket{job=\"ems-app\",endpoint!=\"/metrics\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(ems_http_request_duration_seconds_bucket{job=\"ems-app\",endpoint!=\"/metrics\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Error budget burn rate (1h, x normal)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ems:slo_errors:ratio_rate1h / 0.005",
          "legendFormat": "availability"
        },
        {
          "refId": "B",
          "expr": "ems:slo_latency:ratio_rate1h / 0.05",
          "legendFormat": "latency"
        },
        {
          "refId": "C",
          "expr": "vector(14.4)",
          "legendFormat": "fast-burn threshold"
        },
        {
          "refId": "D",
          "expr": "vector(6)",
          "legendFormat": "slow-burn threshold"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Responses by status",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(ems_http_requests_total{job=\"ems-app\",endpoint!=\"/metrics\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    }
  ]
}