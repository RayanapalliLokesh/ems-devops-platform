# ===== Copy to .env and edit (never commit .env) =====
# Used by `python run.py` (development) and by docker-compose.yml (production stack)
FLASK_APP=run.py
FLASK_ENV=development            # development | production | testing

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-string

# Leave unset to use <project>/data/employees.db
# DATABASE_URL=sqlite:////absolute/path/employees.db
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/employees_db

SQLALCHEMY_ECHO=False
APP_NAME=Employee Management System
APP_VERSION=1.0.0

LOG_LEVEL=DEBUG
LOG_FILE=logs/app.log
LOG_FORMAT=text                  # text | json

# ----- Docker Compose stack (Phase 17) -----
POSTGRES_DB=ems
POSTGRES_USER=ems
POSTGRES_PASSWORD=change-this-db-password
EMS_IMAGE=ems-app
EMS_IMAGE_TAG=local
EMS_HTTP_PORT=8080               # 80 on the EC2 host
TRUSTED_PROXIES=1                # 1 = nginx only; 2 = ALB + nginx
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318   # set by docker-compose.monitoring.yml
